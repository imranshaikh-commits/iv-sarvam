# Sarvam — Open WebUI with IV branding baked in.
#
# Thin layer on top of a pinned Open WebUI release (see FROM) that:
#   - replaces the logo/favicon assets with the Inspirit Vision icon mark
#   - runs deploy/patch-webui.py to (a) strip the forced " (Open WebUI)"
#     brand suffix from WEBUI_NAME and (b) force the sign-in logo to render
#     centered above the title.
#
# The custom name itself is set via the WEBUI_NAME env var in
# docker-compose.yml. Rebuild with:  docker compose up -d --build
#
# PINNED (audit 2026-10-12, finding 12). This used to follow the moving `:main`
# tag, so any rebuild could pull a new Open WebUI. Shilpi depends on its
# internals in three places: patch-webui.py edits its source, the brain reads
# attachments from its uploads directory, and the brain reads the `file` table
# of its database to tell whose upload is whose.
#
# The digest is the exact image production was running on 2026-10-12 (read
# from the host with `docker image inspect ...:main`), when all three were
# verified: a `:main` build that reports version 0.10.2. It is not the
# `v0.10.2` tag, which is a separate build of the same release
# (sha256:9fcea9c6...). Pinning these bits means a rebuild changes nothing.
# To upgrade: replace the digest, rebuild, then check the patch output below,
# an RFP upload in chat, and `select count(*) from file` from the brain.
FROM ghcr.io/open-webui/open-webui@sha256:a26effeb220e132482bf7e0560b3404843e7bc40d23051144e062960df8df6b0

# --- IV logo + favicon assets (served from /static/...) --------------------
# /static/favicon.png      -> sign-in page logo AND browser tab icon (app.html <link rel="icon">)
# /static/logo.png         -> PWA manifest + sidebar
# /static/favicon-96x96.png-> apple-touch / extra icon
# /static/favicon-dark.png -> sign-in logo in dark mode
# /static/favicon.ico      -> legacy shortcut icon
COPY assets/iv-logo.png     /app/backend/open_webui/static/favicon.png
COPY assets/iv-logo.png     /app/backend/open_webui/static/logo.png
COPY assets/iv-logo-96.png  /app/backend/open_webui/static/favicon-96x96.png
COPY assets/iv-logo-dark.png /app/backend/open_webui/static/favicon-dark.png
COPY assets/iv-logo.ico     /app/backend/open_webui/static/favicon.ico

# The compiled frontend (/app/build/static/) ships its OWN default logo assets,
# which OWUI uses for the in-app logo (sidebar + sign-in) when /api/config emits
# no logo URL. Overwrite those too so the IV mark renders everywhere, not just
# the browser-tab favicon served from the backend static path above.
COPY assets/iv-logo.png     /app/build/static/favicon.png
COPY assets/iv-logo.png     /app/build/static/logo.png
COPY assets/iv-logo-96.png  /app/build/static/favicon-96x96.png
COPY assets/iv-logo-dark.png /app/build/static/favicon-dark.png
COPY assets/iv-logo.ico     /app/build/static/favicon.ico

# --- source patches --------------------------------------------------------
COPY patch-webui.py /tmp/patch-webui.py
RUN python3 /tmp/patch-webui.py && \
    rm -f /app/backend/open_webui/__pycache__/env.*.pyc \
          /app/backend/open_webui/__pycache__/main.*.pyc && \
    echo "--- env.py WEBUI_NAME ---" && grep -n "WEBUI_NAME =" /app/backend/open_webui/env.py && \
    echo "--- main.py auth_logo_position ---" && grep -n "auth_logo_position" /app/backend/open_webui/main.py
